# Copy to .env (git-ignored) or set these in your host's dashboard. Never commit real keys.
GEMINI_API_KEY=            # Google AI Studio key (default provider)
# OPENAI_API_KEY=          # alternative provider
# LLM_PROVIDER=gemini      # gemini | openai (auto-detected from the key)
# MODEL=gemini-3.8-flash,gemini-3.5-flash-lite   # optional; comma list = fallback order
# BRAVE_API_KEY=           # optional: more reliable web search than the keyless default
TRUST_PROXY=1              # set when running behind Render/Railway/Fly
GEN_PER_HOUR=10            # per visitor IP
GEN_PER_DAY=150            # whole server (caps API spend)
GEN_CONCURRENCY=3
